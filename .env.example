# CyberClaw 环境配置示例文件
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env

# ==================== 模型配置 ====================

# 默认模型提供商 (可选：openai, anthropic, aliyun, tencent, z.ai, ollama, other)
DEFAULT_PROVIDER=aliyun

# 默认模型名称
DEFAULT_MODEL=glm-5

# ==================== OpenAI 兼容配置 ====================
# 适用于：OpenAI、阿里云、腾讯云、Z.AI 等兼容接口

# API Key (必填，除非使用 Ollama)
OPENAI_API_KEY=sk-your-api-key-here

# Base URL（官方 Provider 可留空；DEFAULT_PROVIDER=other 时必填）
# OpenAI 官方：https://api.openai.com/v1
# 阿里云：https://dashscope.aliyuncs.com/compatible-mode/v1
# 阿里云 coding: https://coding.dashscope.aliyuncs.com/v1
OPENAI_API_BASE=https://coding.dashscope.aliyuncs.com/v1

# ==================== Provider 调用策略 ====================
# 均为可选配置；最大尝试次数包含第一次请求。
# 仅限流、超时、连接失败和服务端错误会重试；等待时间采用有限指数退避。
# CYBERCLAW_PROVIDER_MAX_ATTEMPTS=3
# CYBERCLAW_PROVIDER_TIMEOUT_SECONDS=60

# ==================== 单次任务运行预算 ====================
# 均为可选配置；默认值足以直接运行。每次新的用户输入都会重新计数。
# 递归上限至少应为模型调用上限的 2 倍再加 1。

# Agent 主循环模型调用次数（不包含上下文摘要等辅助调用）
# CYBERCLAW_MAX_MODEL_CALLS=20
# CYBERCLAW_MAX_TOOL_CALLS=50
# CYBERCLAW_RECURSION_LIMIT=50

# 模型上下文窗口大小；用于近似 Token 分层裁剪，不是精确计数器
# CYBERCLAW_CONTEXT_MAX_TOKENS=64000

# ==================== Anthropic 配置 ====================
# 仅在 DEFAULT_PROVIDER=anthropic 时使用

# API Key
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Base URL (可选，使用代理时配置)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# ==================== 受限程序执行（默认关闭） ====================
# 这不是操作系统级沙盒。只有在你信任待运行程序时才显式开启。
# 开启后仍只允许下方白名单中的单个程序，不支持 PowerShell/CMD/Bash、
# 管道、重定向、命令连接、绝对路径或父目录跳转。

# CYBERCLAW_ENABLE_SHELL=false
# CYBERCLAW_SHELL_ALLOWED_COMMANDS=python

# ==================== Ollama 配置 ====================
# 仅在 DEFAULT_PROVIDER=ollama 时使用

# Ollama 本地服务地址 (默认：http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
